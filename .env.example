# ---- Copy this file to .env and fill in your values ----
PORT=3000
SESSION_SECRET=please-change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password
DB_NAME=bookly

# Email (appointment confirmation/cancellation notices)
# Optional: leave SMTP_HOST blank to use a free Ethereal test inbox in dev
# (nothing is really delivered; a preview link is logged to the console).
EMAIL_FROM=Bookly <no-reply@bookly.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
